{
  "name": "flow-hooks",
  "version": "2.0.0",
  "description": "Build async flows from small, immutable, reducer-style steps: sequence, branch, race and run in parallel, with cancellation and AbortSignal support. Typed, zero dependencies.",
  "keywords": [
    "async",
    "flow",
    "flow-control",
    "control-flow",
    "pipeline",
    "workflow",
    "middleware",
    "steps",
    "hooks",
    "reducer",
    "immutable",
    "promise",
    "parallel",
    "race",
    "cancel",
    "cancellation",
    "abort",
    "abortsignal",
    "typescript",
    "zero-dependency"
  ],
  "homepage": "https://radenkovic.github.io/flow-hooks/",
  "bugs": {
    "url": "https://github.com/radenkovic/flow-hooks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radenkovic/flow-hooks.git"
  },
  "license": "MIT",
  "author": "Dan Radenkovic <dan@radenkovic.org> (https://github.com/radenkovic)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:package",
    "example": "npm run build --silent && node",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
